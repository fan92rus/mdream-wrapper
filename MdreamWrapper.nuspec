<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2012/06/nuspec.xsd">
  <metadata>
    <id>MdreamWrapper</id>
    <version>1.1.0</version>
    <description>C# wrapper with native mdream (HTML to Markdown) via P/Invoke</description>
    <authors>fan92rus</authors>
    <repository type="git" url="https://github.com/fan92rus/mdream-wrapper" />
    <license type="expression">MIT</license>
    <readme>README.md</readme>
    <dependencies>
      <group targetFramework="net9.0" />
    </dependencies>
  </metadata>
  <files>
    <file src="README.md" target="" />
    <file src="build\MdreamWrapper.targets" target="build\net9.0\MdreamWrapper.targets" />
    <file src="artifacts\win-x64\mdream_wrapper.dll" target="runtimes\win-x64\native\mdream_wrapper.dll" />
    <file src="artifacts\linux-x64\libmdream_wrapper.so" target="runtimes\linux-x64\native\libmdream_wrapper.so" />
    <file src="artifacts\managed\net9.0\MdreamWrapper.dll" target="lib\net9.0\MdreamWrapper.dll" />
  </files>
</package>
